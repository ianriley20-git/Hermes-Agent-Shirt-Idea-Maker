# Copy this file to config/.env (or ~/.hermes/.env on the always-on machine)
# and fill in real values. Never commit the filled-in file.
#
# Hermes reads secrets from ~/.hermes/.env on the machine it runs on. If you
# keep a copy here in config/.env for local reference, treat it as the same
# secret material — it's gitignored, but don't paste it anywhere else.

# --- Model provider (pick at least one; set with `hermes model`) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Telegram gateway (Stage 1) ---
# Create a bot via @BotFather to get the token.
# Find your numeric user id by messaging @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
# Where scheduled/cron output gets delivered by default (Stage 2+):
TELEGRAM_HOME_CHANNEL=

# --- Dropbox upload (Stage 6) ---
# Approved designs land in this app's Dropbox App folder, under /to-do.
# See install/01_provision_vps.md Part 13 for how to create the app and
# generate these values (App Console -> Settings for the key/secret; the
# OAuth authorize + token-exchange flow for the refresh token).
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# --- Image generation (Stage 5) ---
# Reuses OPENAI_API_KEY above if using GPT-4o/DALL-E for image gen.
# Add a separate key here only if the image provider differs from the model provider.
IMAGE_GEN_API_KEY=
